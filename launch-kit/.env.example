# .env.example — متغیرهای docker-compose.yml.  کپی کنید به .env (که در مخزن commit نمی‌شود) و پر کنید.
# هیچ راز/کلید خصوصی اینجا نیست؛ فقط «مسیر فایل کلید» که خودِ فایل را اپراتور خارج از مخزن می‌گذارد.

# --- تصویر (سنجاق‌شده؛ latest ممنوع) ---
SUR_BESU_TAG=26.9.0

# --- هویت کانتینر/volume/شبکه (برای چند نود روی یک میزبان یا آزمون عوض کنید) ---
SUR_CONTAINER_NAME=sur-validator
SUR_VOLUME_NAME=sur-validator-data
SUR_NETWORK_NAME=sur-validator-net

# --- OWNER: آدرس IP عمومی ثابت همین ولیدیتور (به همتاها اعلام می‌شود؛ مقدار جای‌گیر را عوض کنید) ---
SUR_P2P_HOST=CHANGE_ME_PUBLIC_IP

# --- پورت‌ها (روی میزبان). P2P عمومی؛ RPC و متریک فقط روی 127.0.0.1 publish می‌شوند ---
SUR_P2P_PORT=30303
# آدرس IPv4 که P2P روی آن منتشر می‌شود. پیش‌فرض 0.0.0.0 = فقط IPv4 (نحو کوتاه بدون آدرس روی [::] هم منتشر می‌کرد و آن مسیر از DOCKER-USER رد نمی‌شود؛ README بخش ۳ مرحلهٔ ۶).
# فقط یک آدرس IPv4 بدهید؛ مقدار IPv6 (مثل ::) دوباره مسیر بی‌فیلتر باز می‌کند.
# معنا: SUR_P2P_BIND باید IPv4 یک رابط **محلی** همین میزبان باشد (پیش‌فرض 0.0.0.0 = همهٔ رابط‌های IPv4). روی ابرهایی که IP عمومی با NAT یک‌به‌یک به میزبان می‌رسد
# (رابط میزبان فقط IP خصوصی دارد) اگر می‌خواهید محدود کنید IP **خصوصی** را بگذارید، نه IP عمومی؛ مقدار غیرمحلی با «cannot assign requested address» شکست می‌خورد (مشاهدهٔ بازبین دور ۴).
# SUR_P2P_HOST (بالا) همان IP **عمومی تبلیغ‌شده** در enode می‌ماند و ربطی به SUR_P2P_BIND ندارد. p2p-interface در config.toml (داخل کانتینر) باید 0.0.0.0 بماند.
SUR_P2P_BIND=0.0.0.0
SUR_RPC_PORT=8545
SUR_METRICS_PORT=9545

# --- chainId مورد انتظار healthcheck (هگز). 262 = 0x106. برای آزمون با genesis.TEST-ONLY.json (262025) = 0x3ff89 ---
SUR_CHAIN_ID_HEX=0x106

# --- مسیر فایل‌ها «روی میزبان» (مطلق یا نسبی به این پوشه). همه باید وجود داشته باشند ---
SUR_CONFIG_FILE=./config.toml
SUR_STATIC_NODES_FILE=./static-nodes.json
# genesis تولیدی: خروجی `build` (و `verify` شده) همراه sha256 اعلام‌شده. در کیت وجود ندارد (README):
SUR_GENESIS_FILE=/opt/sur/genesis.json
# کلید اپراتور این نود (hex 64 رقمی)؛ خارج از مخزن، هرگز commit/ایمیل/چاپ نشود. مالک فایل باید دقیقاً uid 1000 باشد (کانتینر با user: 1000:1000 اجرا می‌شود) و مجوز 0400:
#     sudo chown 1000:1000 /opt/sur/secrets/node.key && sudo chmod 0400 /opt/sur/secrets/node.key
# با مالک root یا uid دیگر (مثلاً 1001) Besu کلید را نمی‌خواند و با پیام «گمراه‌کننده» می‌افتد و در حلقهٔ crash/ری‌استارت می‌ماند:
#     «Supplied file does not contain valid keyPair» (با مالک root و 0400 هم همین پیام: بازبین دور ۲ بازتولید کرد). سازندهٔ قبلی برای root/0400 متن «Private key cannot be loaded from file» دیده بود؛ بازبین آن را بازتولید نکرد. متن خطا از «مالکیت/دسترسی» حرفی نمی‌زند.
SUR_NODE_KEY_FILE=/opt/sur/secrets/node.key
# حجم داده (SUR_VOLUME_NAME) هم باید پیش از اولین up یک‌بار chown 1000:1000 شود (README بخش ۳ مرحلهٔ ۵).
# توصیه: uid اختصاصی (مثلاً 10001) به‌جای 1000 که روی Ubuntu cloud معمولاً کاربر ورود است؛ در این‌صورت user: در compose، chown حجم و chown کلید همه با همان uid (README بخش ۵؛ 1000 پیش‌فرض آزموده‌شده است).
# config.toml، genesis.json و static-nodes.json باید برای uid کانتینر خوانا باشند (0644 یا مالک همان uid)؛ با 0600 و مالک root، Besu با کد 2 می‌افتد (README بخش ۵).

# --- فقط برای profile مانیتورینگ ---
SUR_PROMETHEUS_TAG=v3.13.4
SUR_PROMETHEUS_PORT=9090
