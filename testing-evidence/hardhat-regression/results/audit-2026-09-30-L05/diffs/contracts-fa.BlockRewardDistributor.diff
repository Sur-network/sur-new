+    function _rateEntriesUpTo(uint256 blockNumber) private view returns (uint256 lo) {
+        uint256 hi = rewardRateChanges.length;
+        while (lo < hi) {
+            uint256 mid = (lo + hi) / 2;
+            if (rewardRateChanges[mid].startBlock <= blockNumber) lo = mid + 1;
+            else hi = mid;
+        }
+    }
