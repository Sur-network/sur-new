+        if (p.approvedAt == 0) return (block.timestamp > p.votingExpiresAt ? 2 : 1, 0);
+        problem = BOARD_CONTRACT.boardVersion() != p.boardVersionAtCreation ? 1 : _rateStartProblem(p.startBlock);
+        if (problem != 0) return (6, problem);
